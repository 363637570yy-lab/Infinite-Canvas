# 运行时数据（服务器由持久化挂载承载，不入库）
runtime/
data/canvases/
data/conversations/
assets/input/
assets/library/
assets/output/
assets/uploads/
output/

# 凭据（真实值只存服务器 runtime/API/.env）
*.env.local
.env.local

# 本地运维配置与临时产物
